# Terraform state, raw plan files, provider caches, lockfiles, credentials, and
# environment-specific tfvars remain ignored by the deny-all default.

# ----- [ Framework-template baseline-manifest mirror ] --------------------------------------------
# Mirrors of NWarila/terraform-framework-template@<pin> baseline-manifest.json
# byte_identical entries. Drift is enforced by template-sync.yaml; do not
# modify these files locally - bump the SHA pin in template-sync.yaml instead.

# Reusable workflows pulled in for byte-identical mirroring (callers cross-repo
# via `uses:`; local copies satisfy drift-gate).
!/.github/workflows/reusable-auto-merge.yaml
!/.github/workflows/reusable-codeql.yaml
!/.github/workflows/reusable-iac-security.yaml
!/.github/workflows/reusable-release-evidence.yaml
!/.github/workflows/reusable-release-please.yaml
!/.github/workflows/reusable-scorecard.yaml
!/.github/workflows/reusable-terraform-deploy.yaml

