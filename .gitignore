# ----- [ Terraform module sources and tests ] -----------------------------------------------------

!/terraform/
!/terraform/locals.tf
!/terraform/outputs.tf
!/terraform/resources.tf
!/terraform/variables.tf
!/terraform/versions.tf
!/terraform/tests/
!/terraform/tests/validation.tftest.hcl

# Terraform state, raw plan files, provider caches, lockfiles, credentials, and
# environment-specific tfvars remain ignored by the deny-all default.
