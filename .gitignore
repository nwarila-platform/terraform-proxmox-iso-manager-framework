# Default deny: nothing is tracked unless explicitly allowed below. Implements
# org ADR-0003 (Use a Deny-All `.gitignore` Strategy).
**

# ----- [ Repository self-management ] -------------------------------------------------------------

!/.gitignore
!/.gitattributes
!/.editorconfig
!/.template-type
!/.markdownlint-cli2.jsonc
!/.pre-commit-config.yaml
!/.terraform-docs.yml
!/.tflint.hcl
!/Makefile

# ----- [ Top-level documentation ] ----------------------------------------------------------------

!/README.md
!/CHANGELOG.md
!/LICENSE

# ----- [ Documentation ] --------------------------------------------------------------------------

!/docs/
!/docs/README.md

# ADRs.
!/docs/decision-records/
!/docs/decision-records/README.md
!/docs/decision-records/org/
!/docs/decision-records/org/0001-use-architecture-decision-records.md
!/docs/decision-records/org/0002-adopt-diataxis-documentation-framework.md
!/docs/decision-records/org/0003-use-deny-all-gitignore-strategy.md
!/docs/decision-records/org/0004-use-renovate-for-dependency-updates.md
!/docs/decision-records/org/0005-pin-terraform-and-provider-versions-exactly.md
!/docs/decision-records/repo/
!/docs/decision-records/repo/0001-terraform-subdirectory-layout.md
!/docs/decision-records/repo/0002-use-repo-local-renovate-baseline.md
!/docs/decision-records/repo/0003-allow-example-local-readmes.md

# Diataxis quadrants.
!/docs/reference/
!/docs/reference/terraform.md
!/docs/reference/release-gates.md
