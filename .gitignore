!/tests/
!/tests/fixtures/
!/tests/fixtures/minimal/
!/tests/fixtures/minimal/main.tf
!/tests/fixtures/minimal/outputs.tf
!/tests/fixtures/minimal/versions.tf
!/tests/fixtures/packer-consumer/
!/tests/fixtures/packer-consumer/main.tf
!/tests/fixtures/packer-consumer/outputs.tf
!/tests/fixtures/packer-consumer/versions.tf

