# Default deny: nothing is tracked unless explicitly allowed below. Implements
# org ADR-0003 (Use a Deny-All `.gitignore` Strategy).
**

# ----- [ Repository self-management ] -------------------------------------------------------------

# Allow the allowlist itself so tracked scope stays auditable.
!/.gitignore

# Allow git attributes so line endings and diffs stay deterministic.
!/.gitattributes

# Allow editor settings shared by all contributors.
!/.editorconfig

# Allow markdownlint-cli2 config so local and CI markdown rules match.
!/.markdownlint-cli2.jsonc

# ----- [ Top-level documentation ] ----------------------------------------------------------------

# Allow README so consumers see usage instructions on the repository landing page.
!/README.md

# Allow changelog so release-please has a target file to maintain.
!/CHANGELOG.md

# Allow contribution guide so contributors see the local override of org defaults.
!/CONTRIBUTING.md

# Allow support policy so help routes are documented in-repo.
# SECURITY.md is intentionally absent — inherited from nwarila-platform/.github
# per the org community-health-file inheritance pattern.
!/SUPPORT.md

# Allow license so the module's licensing terms stay clearly attached.
!/LICENSE

# ----- [ Architecture Decision Records ] ----------------------------------------------------------

# Allow the docs root so governance and Diátaxis material can live alongside module HCL.
!/docs/

# Allow the Diátaxis index README.
!/docs/README.md

# Allow the decision-records directory and per-repo index per org ADR-0001.
!/docs/decision-records/
!/docs/decision-records/README.md

# Allow the org-baseline ADR mirrors. These are kept byte-identical to their
# masters at nwarila-platform/.github/docs/decision-records/ by the Org ADR Sync
# workflow; do not edit directly.
!/docs/decision-records/org/
!/docs/decision-records/org/0001-use-architecture-decision-records.md
!/docs/decision-records/org/0002-adopt-diataxis-documentation-framework.md
!/docs/decision-records/org/0003-use-deny-all-gitignore-strategy.md
!/docs/decision-records/org/0004-use-renovate-for-dependency-updates.md
!/docs/decision-records/org/0005-pin-terraform-and-provider-versions-exactly.md

# Allow the repo-specific ADRs.
!/docs/decision-records/repo/
!/docs/decision-records/repo/0001-terraform-subdirectory-layout.md

# ----- [ Diátaxis quadrants ] ---------------------------------------------------------------------

# Allow reference material per org ADR-0002.
!/docs/reference/
!/docs/reference/terraform.md

# Allow how-to guides per org ADR-0002.
!/docs/how-to/
!/docs/how-to/use-from-a-packer-template.md

# Allow conceptual explainers per org ADR-0002.
!/docs/explanation/
!/docs/explanation/threat-model.md

# ----- [ Release automation ] ---------------------------------------------------------------------

# Allow release-please config so changelog sections and release type stay versioned.
!/release-please-config.json

# Allow release-please manifest so the current version pin stays versioned.
!/.release-please-manifest.json

# ----- [ GitHub configuration ] -------------------------------------------------------------------

# Allow the GitHub config root so inherited defaults and repo automation are versioned.
!/.github/

# Allow code owners so PR review routing stays consistent.
!/.github/CODEOWNERS

# Allow Renovate config so dependency update behaviour stays versioned. Extends
# the shared org baseline at nwarila-platform/.github (see org ADR-0004).
!/.github/renovate.json5

# Allow PR template so contribution expectations stay consistent.
!/.github/pull_request_template.md

# Allow issue template directory so default intake forms stay tracked.
!/.github/ISSUE_TEMPLATE/

# Allow bug form so defect intake stays structured.
!/.github/ISSUE_TEMPLATE/01-bug-report.yml

# Allow feature form so enhancement requests stay structured.
!/.github/ISSUE_TEMPLATE/02-feature-request.yml

# Allow documentation form so docs fixes route through a dedicated template.
!/.github/ISSUE_TEMPLATE/03-documentation.yml

# Allow issue chooser config so support and security links stay intentional.
!/.github/ISSUE_TEMPLATE/config.yml

# Allow workflow directory so repo CI definitions stay tracked.
!/.github/workflows/

# Allow CodeQL workflow so static analysis stays versioned.
!/.github/workflows/codeql.yaml

# Allow PR validation workflow so terraform fmt/init/validate/test gates stay versioned.
!/.github/workflows/pr-validation.yaml

# Allow release-please workflow so release automation stays versioned.
!/.github/workflows/release-please.yaml

# Allow repo-ci workflow so actionlint and markdownlint baseline gates stay versioned.
!/.github/workflows/repo-ci.yml

# Allow security workflow so trivy and gitleaks scans stay versioned.
!/.github/workflows/security.yaml

# Allow the org-adr-sync caller so mirror integrity is enforced on every PR
# and refreshed on a weekly schedule (see org ADR-0001).
!/.github/workflows/org-adr-sync.yml

# ----- [ Terraform module sources and tests ] -----------------------------------------------------

# Allow the terraform module directory so module HCL stays tracked (see repo ADR-0001).
!/terraform/

# Allow locals so derived values stay versioned.
!/terraform/locals.tf

# Allow outputs so the module's external contract stays versioned.
!/terraform/outputs.tf

# Allow resources so the module's managed objects stay versioned.
!/terraform/resources.tf

# Allow variables so the module's input contract stays versioned.
!/terraform/variables.tf

# Allow versions so terraform and provider version constraints stay versioned.
!/terraform/versions.tf

# Allow the tests directory so terraform test coverage stays versioned.
!/terraform/tests/
!/terraform/tests/validation.tftest.hcl
