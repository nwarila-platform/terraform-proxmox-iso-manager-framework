{
  // Schema for editor validation. Update only when intentionally adopting a new schema.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Thin consumer config. Stack-wide Renovate policy
  // (rangeStrategy=pin for terraform, pinDigests for actions, supply-chain
  // quarantine, custom managers for `# renovate:` annotations, schedule,
  // etc.) lives in NWarila/terraform-framework-template. This file keeps
  // only repo-specific dep grouping.
  //
  // The extends does not pin a ref (Renovate preset extends doesn't support
  // SHA-pinning of the preset source itself); it follows the upstream main
  // branch. The tradeoff is that preset changes propagate without an
  // intermediate consumer PR. See ADR-0002 for the full rationale.
  "extends": [
    "github>NWarila/terraform-framework-template//.github/renovate.json5"
  ],

  "packageRules": [
    {
      // Bumps to NWarila/terraform-framework-template itself (the
      // template SHA pin in workflow `uses:` references and the
      // `source-ref` of NWarila/drift-gate callers). Reviewed manually
      // because they affect every CI gate's behavior.
      "matchDepNames": ["NWarila/terraform-framework-template"],
      "groupName": "terraform-framework-template",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": false
    }
  ]
}
