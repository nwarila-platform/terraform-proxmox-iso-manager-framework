{
  // Schema for editor validation. Update only when intentionally adopting a new schema.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Repo-local Renovate baseline. ADR-0004 allows a shared org baseline, but this
  // repository keeps the effective policy in-tree so dependency automation remains
  // operational even if the special .github repository is incomplete.
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "schedule:weekly"
  ],

  "labels": ["dependencies"],
  "prConcurrentLimit": 5,

  "enabledManagers": [
    "github-actions",
    "terraform"
  ],

  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["terraform"],
      "rangeStrategy": "pin",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    }
  ]
}
